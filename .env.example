# Copy to .env.local. Restart `npm run dev` after changes.
# All of these are optional. The site builds and runs without them.
# Until the Stripe URL is set, trial buttons open /start and offer email.

# One checkout URL for every plan. {plan} and {interval} are replaced when present.
# Otherwise ?plan= and ?interval= are appended.
# plan: owner_operator | small_fleet | fleet_pro
# interval: monthly | yearly
NEXT_PUBLIC_STRIPE_SIGNUP_URL=

# Optional per-plan Stripe Payment Links. These win over NEXT_PUBLIC_STRIPE_SIGNUP_URL.
NEXT_PUBLIC_STRIPE_SIGNUP_URL_OWNER_OPERATOR_MONTHLY=
NEXT_PUBLIC_STRIPE_SIGNUP_URL_OWNER_OPERATOR_YEARLY=
NEXT_PUBLIC_STRIPE_SIGNUP_URL_SMALL_FLEET_MONTHLY=
NEXT_PUBLIC_STRIPE_SIGNUP_URL_SMALL_FLEET_YEARLY=
NEXT_PUBLIC_STRIPE_SIGNUP_URL_FLEET_PRO_MONTHLY=
NEXT_PUBLIC_STRIPE_SIGNUP_URL_FLEET_PRO_YEARLY=

# Existing-customer app. Header "Sign in" uses this. Unset sends people to /sign-in.
NEXT_PUBLIC_APP_URL=

# Fuel-card tracking links. See AFFILIATES.md.
# Empty buttons say "Get offer" and open the official program page.
# TSS says "Partner inquiry" until NEXT_PUBLIC_AFFILIATE_TSS is set.
NEXT_PUBLIC_AFFILIATE_COAST=
NEXT_PUBLIC_AFFILIATE_ROADFLEX=
NEXT_PUBLIC_AFFILIATE_ATOB=
NEXT_PUBLIC_AFFILIATE_WEX=
NEXT_PUBLIC_AFFILIATE_TSS=
NEXT_PUBLIC_AFFILIATE_MUDFLAP=

# Optional Google Ads / GA tag. Only AW- or G- IDs are loaded.
NEXT_PUBLIC_GOOGLE_ADS_ID=
