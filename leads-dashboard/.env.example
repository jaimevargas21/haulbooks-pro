# Copy to .env for local development:
#   cp .env.example .env
#
# Demo mode needs no database. The UI loads seeded trucking leads in memory.
# Set DEMO_MODE=0 and a DATABASE_URL when you want records to persist.

# Required. Single shared password. There is no public signup.
DASHBOARD_PASSWORD=change-me-now

# Required in production. At least 16 characters. Signs the httpOnly session cookie.
# Local `next dev` falls back to a dev-only secret if this is empty.
SESSION_SECRET=replace-with-a-long-random-string

# Required for POST /api/ingest. The support agent sends this as x-api-key.
INGEST_API_KEY=replace-with-another-long-random-string

# 1 = in-memory seeded data, even if DATABASE_URL is set.
# Leave this as 1 until Neon (or local SQLite) is ready.
# On Vercel, set DEMO_MODE=1 to show the dashboard before the database is linked.
DEMO_MODE=1

# Local SQLite (file lives at prisma/dev.db). Also set DEMO_MODE=0.
# DATABASE_URL="file:./dev.db"

# Neon Postgres (pooled). Also set DEMO_MODE=0.
# Use the pooled host (it contains "-pooler") on Vercel.
# If Prisma reports prepared-statement errors, add &pgbouncer=true.
# DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
