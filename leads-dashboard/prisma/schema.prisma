// Local SQLite schema. The database file is prisma/dev.db.
// Production uses prisma/schema.postgres.prisma with Neon. Do not point this
// file at Postgres — the app picks the client from DATABASE_URL.

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/sqlite"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Lead {
  id           String   @id @default(cuid())
  externalId   String   @unique
  company      String
  email        String   @unique
  city         String
  state        String
  fleetSize    Int
  status       String
  notes        String   @default("")
  lastActivity DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  replies      Reply[]

  @@index([status])
  @@index([lastActivity])
}

model Reply {
  id           String   @id @default(cuid())
  externalId   String?  @unique
  leadId       String?
  lead         Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  fromEmail    String
  subject      String
  inboundBody  String
  draftBody    String
  status       String
  reviewerNote String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([leadId])
}

model Ticket {
  id         String   @id @default(cuid())
  externalId String?  @unique
  subject    String
  fromEmail  String
  body       String   @default("")
  status     String
  priority   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([priority])
}
